MONGODB_URI=mongodb://127.0.0.1:27017/interview_ai
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER=mock

# Optional free-tier provider. Leave unset to use the local mock provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=

# Optional SMTP settings for password reset and email verification.
# If unset, auth emails are logged server-side in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prepwise AI <no-reply@prepwise.local>"
